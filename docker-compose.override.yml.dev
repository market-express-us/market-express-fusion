# VPS Dev Environment Override
# Author: Colin Bitterfield
# Email: colin@bitterfield.com
# Date Created: 2026-01-20
# Updated: 2026-03-24
# Version: 1.2.0
#
# Changelog:
#   1.2.0: Add priority=10 to beat HostRegexp catch-all (auth-dev was never DNS-provisioned)
#   1.1.0: Change Traefik host from auth-dev.marketexpress.us to auth.marketexpress.us
#   1.0.0: Initial dev override

services:
  fusionauth:
    volumes:
      - ./kickstart-dev.json:/usr/local/fusionauth/kickstart/kickstart-dev.json:ro
    networks:
      - db_net
      - market-express-proxy
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=market-express-proxy"
      - "traefik.http.routers.fusionauth.rule=Host(`auth.marketexpress.us`)"
      - "traefik.http.routers.fusionauth.entrypoints=websecure"
      - "traefik.http.routers.fusionauth.tls=true"
      - "traefik.http.routers.fusionauth.tls.certresolver=letsencrypt"
      - "traefik.http.services.fusionauth.loadbalancer.server.port=9011"
      # Priority 10 ensures this beats the HostRegexp catch-all (priority 1, but
      # auto-calculated length-based priority of HostRegexp can exceed Host())
      - "traefik.http.routers.fusionauth.priority=10"
    ports: []

networks:
  market-express-proxy:
    external: true
