      "method": "POST",
      "url": "/api/application/#{adminApplicationId}",
      "tenantId": "#{defaultTenantId}",
      "body": {
        "application": {
          "name": "marketexpress-admin",
          "tenantId": "#{defaultTenantId}",
          "oauthConfiguration": {
            "authorizedRedirectURLs": [
              "#{backendURL}/auth/fusionauth/callback",
              "#{adminPanelURL}/auth/fusionauth/callback",
              "#{adminPanelURL}/admin/auth/fusionauth/callback",
              "http://localhost:4400/auth/fusionauth/callback",
              "http://localhost:4400/admin/auth/fusionauth/callback",
              "http://localhost:5173/auth/fusionauth/callback"
            ],
            "authorizedOriginURLs": [
              "#{adminPanelURL}",
              "#{backendURL}",
              "http://localhost:4400",
              "http://localhost:5173"
            ],
            "clientId": "#{adminApplicationId}",
            "clientSecret": "#{ADMIN_CLIENT_SECRET}",
            "clientAuthenticationPolicy": "Required",
            "enabledGrants": ["authorization_code","refresh_token"],
            "generateRefreshTokens": true,
            "logoutURL": "#{adminPanelURL}/logout",
            "requireRegistration": true,
            "scopeHandlingPolicy": "Strict",
            "proofKeyForCodeExchangePolicy": "Required"
          },
          "jwtConfiguration": {
            "enabled": true,
            "timeToLiveInSeconds": 28800,
            "refreshTokenTimeToLiveInMinutes": 43200
          },
          "loginConfiguration": { "requireAuthentication": true, "allowTokenRefresh": true },
          "registrationConfiguration": { "enabled": false, "type": "basic" },
          "selfServiceRegistrationConfiguration": { "enabled": false },
          "roles": [
            { "name": "platform-admin",   "description": "Full platform management", "isDefault": false, "isSuperRole": false },
            { "name": "platform-manager", "description": "Operations management", "isDefault": false, "isSuperRole": false },
            { "name": "platform-support", "description": "Read-only support access", "isDefault": false, "isSuperRole": false }
          ]
        }
      }
    },

